{
  "//": "共享基座:仅 baseUrl + 全平台包的源码路径映射。各包 tsconfig.json 自持编译选项(不 extends 本文件),导入时的差异一律保留。",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@catalog/*": [
        "./component-library/src/componentLibrary/*"
      ],
      "@velaros-ai/agent-lab": [
        "./packages/agent-lab/src/index.ts"
      ],
      "@velaros-ai/agent-lab/*": [
        "./packages/agent-lab/src/*"
      ],
      "@velaros-ai/agent": [
        "./packages/agent/src/index.ts"
      ],
      "@velaros-ai/agent/*": [
        "./packages/agent/src/*"
      ],
      "@velaros-ai/browser": [
        "./packages/browser/src/index.ts"
      ],
      "@velaros-ai/browser/contracts": [
        "./packages/browser/src/contracts.ts"
      ],
      "@velaros-ai/browser/electron": [
        "./packages/browser/src/electron.ts"
      ],
      "@velaros-ai/browser/renderer": [
        "./packages/browser/src/renderer.ts"
      ],
      "@velaros-ai/cli": [
        "./packages/cli/src/index.ts"
      ],
      "@velaros-ai/cli/*": [
        "./packages/cli/src/*"
      ],
      "@velaros-ai/ui/conversation": [
        "./packages/ui/src/conversation/index.ts"
      ],
      "@velaros-ai/ui/conversation/*": [
        "./packages/ui/src/conversation/*"
      ],
      "@velaros-ai/core": [
        "./packages/core/src/index.ts"
      ],
      "@velaros-ai/development": [
        "./packages/development/src/index.ts"
      ],
      "@velaros-ai/development/*": [
        "./packages/development/src/*"
      ],
      "@velaros-ai/html-artifacts": [
        "./packages/html-artifacts/src/index.ts"
      ],
      "@velaros-ai/html-artifacts/contracts": [
        "./packages/html-artifacts/src/contracts.ts"
      ],
      "@velaros-ai/core/*": [
        "./packages/core/src/*"
      ],
      "@velaros-ai/kernel": [
        "./packages/kernel/src/index.ts"
      ],
      "@velaros-ai/kernel/contracts": [
        "./packages/kernel/src/contracts.ts"
      ],
      "@velaros-ai/kernel/client": [
        "./packages/kernel/src/client.ts"
      ],
      "@velaros-ai/kernel/serve": [
        "./packages/kernel/src/serve.ts"
      ],
      "@velaros-ai/kernel/remote": [
        "./packages/kernel/src/remote.ts"
      ],
      "@velaros-ai/platform": [
        "./packages/platform/src/index.ts"
      ],
      "@velaros-ai/platform/*": [
        "./packages/platform/src/*"
      ],
      "@velaros-ai/path-rules": [
        "./packages/path-rules/src/index.ts"
      ],
      "@velaros-ai/path-rules/*": [
        "./packages/path-rules/src/*"
      ],
      "@velaros-ai/velar/files": [
        "./packages/velar/files/index.ts"
      ],
      "@velaros-ai/velar/images": [
        "./packages/velar/images/index.ts"
      ],
      "@velaros-ai/velar/sandbox": [
        "./packages/velar/sandbox/index.ts"
      ],
      "@velaros-ai/velar/shell": [
        "./packages/velar/shell/index.ts"
      ],
      "@velaros-ai/velar/project": [
        "./packages/velar/project/index.ts"
      ],
      "@velaros-ai/velar/*": [
        "./packages/velar/*"
      ],
      "@velaros-ai/text-files": [
        "./packages/text-files/src/index.ts"
      ],
      "@velaros-ai/text-files/*": [
        "./packages/text-files/src/*"
      ],
      "@velaros-ai/tool-contract": [
        "./packages/tool-contract/src/index.ts"
      ],
      "@velaros-ai/tool-contract/*": [
        "./packages/tool-contract/src/*"
      ],
      "@velaros-ai/surface-protocol": [
        "./packages/surface-protocol/src/index.ts"
      ],
      "@velaros-ai/surface-protocol/*": [
        "./packages/surface-protocol/src/*"
      ],
      "@velaros-ai/document-renderer": [
        "./packages/document-renderer/src/index.ts"
      ],
      "@velaros-ai/document-renderer/*": [
        "./packages/document-renderer/src/*"
      ],
      "@velaros-ai/system": [
        "./packages/system/src/index.ts"
      ],
      "@velaros-ai/system/*": [
        "./packages/system/src/*"
      ],
      "@velaros-ai/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@velaros-ai/ui/*": [
        "./packages/ui/src/*"
      ],
      "@velaros-ai/project": [
        "./packages/project/src/index.ts"
      ],
      "@velaros-ai/project/*": [
        "./packages/project/src/*"
      ]
    }
  },
  "files": []
}
