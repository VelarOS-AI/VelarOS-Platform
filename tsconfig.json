{
  "//": "共享基座:仅 baseUrl + 全平台包的源码路径映射。各包 tsconfig.json 自持编译选项(不 extends 本文件),导入时的差异一律保留。",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@catalog/*": [
        "./component-library/src/componentLibrary/*"
      ],
      "@velaros-ai/agent-lab": [
        "./packages/agent-lab/src/index.ts"
      ],
      "@velaros-ai/agent-lab/*": [
        "./packages/agent-lab/src/*"
      ],
      "@velaros-ai/agent": [
        "./packages/agent/src/index.ts"
      ],
      "@velaros-ai/agent/*": [
        "./packages/agent/src/*"
      ],
      "@velaros-ai/cli": [
        "./packages/cli/src/index.ts"
      ],
      "@velaros-ai/cli/*": [
        "./packages/cli/src/*"
      ],
      "@velaros-ai/ui/conversation": [
        "./packages/ui/src/conversation/index.ts"
      ],
      "@velaros-ai/ui/conversation/*": [
        "./packages/ui/src/conversation/*"
      ],
      "@velaros-ai/core": [
        "./packages/core/src/index.ts"
      ],
      "@velaros-ai/development": [
        "./packages/development/src/index.ts"
      ],
      "@velaros-ai/development/*": [
        "./packages/development/src/*"
      ],
      "@velaros-ai/core/platform": [
        "./packages/core/platform/index.ts"
      ],
      "@velaros-ai/core/platform/contracts": [
        "./packages/core/platform/contracts.ts"
      ],
      "@velaros-ai/core/platform/shared-resources": [
        "./packages/core/platform/shared-resources.ts"
      ],
      "@velaros-ai/core/text-files": [
        "./packages/core/text-files/index.ts"
      ],
      "@velaros-ai/core/text-files/contracts": [
        "./packages/core/text-files/contracts.ts"
      ],
      "@velaros-ai/core/path-rules": [
        "./packages/core/path-rules/index.ts"
      ],
      "@velaros-ai/core/path-rules/contracts": [
        "./packages/core/path-rules/contracts.ts"
      ],
      "@velaros-ai/core/*": [
        "./packages/core/src/*"
      ],
      "@velaros-ai/kernel": [
        "./packages/kernel/src/index.ts"
      ],
      "@velaros-ai/kernel/contracts": [
        "./packages/kernel/src/contracts.ts"
      ],
      "@velaros-ai/kernel/client": [
        "./packages/kernel/src/client.ts"
      ],
      "@velaros-ai/kernel/serve": [
        "./packages/kernel/src/serve.ts"
      ],
      "@velaros-ai/kernel/remote": [
        "./packages/kernel/src/remote.ts"
      ],
      "@velaros-ai/velar/files": [
        "./packages/velar/files/index.ts"
      ],
      "@velaros-ai/velar/images": [
        "./packages/velar/images/index.ts"
      ],
      "@velaros-ai/velar/sandbox": [
        "./packages/velar/sandbox/index.ts"
      ],
      "@velaros-ai/velar/shell": [
        "./packages/velar/shell/index.ts"
      ],
      "@velaros-ai/velar/project": [
        "./packages/velar/project/index.ts"
      ],
      "@velaros-ai/velar/*": [
        "./packages/velar/*"
      ],
      "@velaros-ai/document-renderer": [
        "./packages/document-renderer/src/index.ts"
      ],
      "@velaros-ai/document-renderer/*": [
        "./packages/document-renderer/src/*"
      ],
      "@velaros-ai/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@velaros-ai/ui/html-artifacts": [
        "./packages/ui/html-artifacts/index.ts"
      ],
      "@velaros-ai/ui/html-artifacts/contracts": [
        "./packages/ui/html-artifacts/contracts.ts"
      ],
      "@velaros-ai/ui/*": [
        "./packages/ui/src/*"
      ]
    }
  },
  "files": []
}
