      "@velaros-ai/kernel-updater": [
        "./packages/kernel-updater/src/index.ts"
      ],
      "@velaros-ai/kernel-updater/*": [
        "./packages/kernel-updater/src/*"
      ],
      "@velaros-ai/knowledge": [
        "./packages/knowledge/src/index.ts"
      ],
      "@velaros-ai/knowledge/*": [
        "./packages/knowledge/src/*"
      ],
      "@velaros-ai/memory": [
        "./packages/memory/src/index.ts"
      ],
      "@velaros-ai/memory-adapter-kernel": [
        "./packages/memory-adapter-kernel/src/index.ts"
      ],
      "@velaros-ai/memory/*": [
