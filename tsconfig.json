    "paths": {
      "@catalog/*": [
        "./component-library/src/componentLibrary/*"
      ],
      "@velaros-ai/agent": [
        "./packages/agent/src/index.ts"
      ],
      "@velaros-ai/agent/*": [
        "./packages/agent/src/*"
      ],
      "@velaros-ai/browser-composition": [
        "./packages/browser-composition/src/index.ts"
      ],
      "@velaros-ai/browser-composition/*": [
        "./packages/browser-composition/src/*"
      ],
      "@velaros-ai/browser-core": [
        "./packages/browser-core/src/index.ts"
      ],
      "@velaros-ai/browser-core/*": [
        "./packages/browser-core/src/*"
      ],
      "@velaros-ai/browser-runtime": [
        "./packages/browser-runtime/src/index.ts"
      ],
      "@velaros-ai/browser-runtime/*": [
        "./packages/browser-runtime/src/*"
      ],
      "@velaros-ai/browser-tools": [
        "./packages/browser-tools/src/index.ts"
      ],
      "@velaros-ai/browser-tools/*": [
        "./packages/browser-tools/src/*"
      ],
      "@velaros-ai/cli": [
        "./packages/cli/src/index.ts"
      ],
      "@velaros-ai/cli/*": [
        "./packages/cli/src/*"
      ],
      "@velaros-ai/computer-runtime": [
        "./packages/computer-runtime/src/index.ts"
      ],
      "@velaros-ai/computer-runtime/*": [
        "./packages/computer-runtime/src/*"
      ],
      "@velaros-ai/computer-tools": [
        "./packages/computer-tools/src/index.ts"
      ],
      "@velaros-ai/computer-tools/*": [
        "./packages/computer-tools/src/*"
      ],
      "@velaros-ai/conversation-ui": [
        "./packages/conversation-ui/src/index.ts"
      ],
      "@velaros-ai/conversation-ui/*": [
        "./packages/conversation-ui/src/*"
      ],
      "@velaros-ai/core": [
        "./packages/core/src/index.ts"
      ],
      "@velaros-ai/core/*": [
        "./packages/core/src/*"
