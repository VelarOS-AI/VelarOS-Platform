      "@velaros-ai/system-tools/*": [
        "./packages/system-tools/src/*"
      ],
      "@velaros-ai/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@velaros-ai/ui/*": [
        "./packages/ui/src/*"
      ],
      "@velaros-ai/workspace": [
        "./packages/workspace/src/index.ts"
      ],
      "@velaros-ai/workspace/*": [
        "./packages/workspace/src/*"
      ]
    }
  },
  "files": []
}
