{
  "name": "velaros-platform",
  "version": "0.6.69",
  "private": true,
  "description": "The shared Kernel and reusable platform packages for the VelarOS personal AI operating system ecosystem.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*"
  ],
  "velaros": {
    "trainVersion": "0.6.37",
    "trainNote": "根 version 是火车版本号,只用来给整列发车的 tag 命名;各包版本独立走 semver,见 README「版本方案」。",
    "//platform": "平台代:同一代内各包互相兼容,跨代才是整体破坏性升级。每个包在自己的 velaros.platform 里声明同一个值,随包发布,消费者装完也读得到;releaseTopology 的不变量④机械核对一致性。",
    "//domainPackages": "各域的包目录单源。域架构门(check:*-arch)据此把「包集合冻结」收敛到本域,新增包必须同时登记此处与该域的 owners 表。",
    "platform": "0.6",
    "domainPackages": {
      "kernel": [
        "kernel"
      ],
      "agent": [
        "agent"
      ],
      "core": [
        "core"
      ],
      "foundations": [
        "script",
        "velaros",
        "context",
        "skill-jsts"
      ],
      "model": [
        "model"
      ],
      "evaluation": [
        "agent-lab"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build/buildPackageTopology.mjs",
    "build:incremental": "node scripts/build/buildPackageTopology.mjs --incremental",
    "generate:package-catalog": "node scripts/build/generatePackageCatalog.mjs",
    "mod": "bun scripts/mod/velaros-mod.mjs",
    "check:package-catalog": "node scripts/build/generatePackageCatalog.mjs --check",
    "//package-pack": "临时 tarball 核验必须走安全入口；它按包目录切换 cwd，并限制目标目录、运行时长与子进程组。",
    "check:package-pack": "node scripts/release/check-package-pack.mjs",
    "check:package-pack-boundary": "node scripts/release/check-package-pack-boundary.mjs",
    "check:package-pack-safety": "bun run check:package-pack-boundary && node --test scripts/release/safe-package-pack.test.mjs",
    "build:devtools-performance-engine": "bun scripts/browser/buildDevtoolsPerformanceEngine.mjs",
    "typecheck": "node scripts/run-workspace-script.mjs typecheck",
    "test": "node scripts/run-workspace-script.mjs test && bun run test:act-eval",
    "test:act-eval": "node --test scripts/agent/act-eval.test.mjs scripts/agent/evidence-checkpoints.test.mjs scripts/agent/harbor/harbor.test.mjs scripts/agent/harbor/trace-export.test.mjs scripts/agent/harbor/request-identity.test.mjs",
    "eval:act": "node scripts/agent/run-act-eval.mjs",
    "//lint": "lint 只报告 error；各包使用所属域的规则。",
    "lint": "eslint . --quiet",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:kernel-schemas": "bun scripts/kernel/check-schemas.mjs",
    "check:kernel-arch": "bun scripts/kernel/check-arch-boundaries.mjs",
    "check:core-semantic-vocabulary": "bun scripts/core/check-semantic-vocabulary.mjs",
    "check:agent-schemas": "node scripts/agent/check-schemas.mjs",
    "check:agent-arch": "bun scripts/agent/check-arch-boundaries.mjs",
    "check:agent-public-api": "node scripts/agent/check-public-api.mjs",
    "check:agent-browser": "bun run --cwd packages/agent check:browser",
    "check:conversation-semantics": "bun scripts/agent/check-conversation-semantics.mjs",
    "check:capabilities-arch": "bun scripts/capabilities/check-arch-boundaries.mjs",
    "check:module-ownership": "bun scripts/ownership/check-module-ownership.mjs",
    "check:lockfile-consistency": "bun scripts/capabilities/check-lockfile-consistency.mjs",
    "check:model-arch": "bun scripts/model/check-arch-boundaries.mjs",
    "test:capabilities": "bun test tests/capabilities",
    "//check:code-style": "语言级写法门使用固定提交的 @velaros-ai/arch-guard，并坚持零 baseline：错误必须在源码中修复。逐条查看用 check:code-style:report。",
    "check:code-style": "arch-guard verify",
    "check:code-style:report": "arch-guard run --no-baseline",
    "check:code-style:fix": "arch-guard run --fix --no-baseline",
    "check:project-arch": "node scripts/velaros/check-project-architecture.mjs",
    "check:agent-lab-package": "bun run --cwd packages/agent-lab check",
    "check:dependency-licenses": "node scripts/quality/check-dependency-licenses.mjs",
    "check:dependency-security": "node --test scripts/security/dependency-probes.test.mjs && node scripts/security/checkPatchedDependencies.mjs && bun audit --ignore GHSA-w5hq-g745-h8pq --ignore GHSA-vfj7-8cjw-p6xm",
    "check:devtools-performance-engine": "bun scripts/browser/buildDevtoolsPerformanceEngine.mjs --check",
    "check:readme-examples": "node scripts/ownership/check-readme-examples.mjs",
    "check:error-construction": "node scripts/quality/check-error-construction.mjs",
    "check:public-readiness": "node --test scripts/quality/check-public-readiness.test.mjs && node scripts/quality/check-public-readiness.mjs",
    "check:platform-generation": "node scripts/release/check-platform-generation.mjs",
    "check:gates": "bun run check:host-contract-consumer && bun run check:release-source && bun run check:package-pack-safety && bun run check:kernel-schemas && bun run check:kernel-arch && bun run check:core-semantic-vocabulary && bun run check:agent-schemas && bun run check:agent-arch && bun run check:agent-public-api && bun run check:agent-browser && bun run check:conversation-semantics && bun run check:capabilities-arch && bun run check:module-ownership && bun run check:readme-examples && bun run check:lockfile-consistency && bun run check:model-arch && bun run check:code-style && bun run check:error-construction && bun run check:project-arch && bun run check:agent-lab-package && bun run check:dependency-licenses && bun run check:dependency-security && bun run check:devtools-performance-engine && bun run check:public-readiness && bun run check:platform-generation && bun run check:script && bun run check:act-catalog && bun run check:package-catalog",
    "//release": "正式发布由 GitHub Actions 执行 release:github；核验源码身份、冻结安装、完整检查与 tarball。",
    "release:verify": "node scripts/release/verify-release-ref.mjs --local-tag",
    "release:dry-run": "node scripts/release/publish-packages.mjs --dry-run",
    "check": "bun run check:package-pack-boundary && bun run build && bun run typecheck && bun run lint && bun run check:format && bun run test && bun run test:suites && bun run check:gates",
    "test:suites": "bun run test:capabilities",
    "release:local": "node scripts/release/publish-packages.mjs --local-tag",
    "release:github": "node scripts/release/publish-packages.mjs --github-release --local-tag",
    "check:release-source": "node --test scripts/release/local-release-identity.test.mjs scripts/release/tar-entry-paths.test.mjs",
    "check:host-contract-consumer": "node scripts/release/check-host-contract-consumer.mjs",
    "generate:script": "node scripts/script/generate-declarations.mjs --write",
    "check:script": "node --test scripts/script/operation-contracts.test.mjs scripts/script/generate-declarations.test.mjs && node scripts/script/generate-declarations.mjs",
    "generate:act-catalog": "node scripts/script/act-catalog.mjs --write",
    "check:act-catalog": "node scripts/script/act-catalog.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@velaros-ai/arch-guard": "github:VelarOS-AI/VelarOS-Arch-Guard#ce2b221d99c1b93736568f281a180ad3593f086f",
    "@velaros-ai/script": "workspace:*",
    "@velaros-ai/velaros": "workspace:*",
    "brace-expansion": "1.1.21",
    "chrome-devtools-frontend": "1.0.1652307",
    "electron": "42.11.16",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "jszip": "^3.10.1",
    "nanoid": "3.3.18",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "argparse": "2.0.1",
    "body-parser": "2.4.0",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.9",
    "hono": "4.13.11",
    "ip-address": "10.7.5",
    "js-yaml": "4.3.2",
    "mermaid": "11.16.1",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "undici": "7.30.1",
    "zod": "4.6.6"
  },
  "dependencies": {
    "@velaros-ai/agent-lab": "workspace:*",
    "@velaros-ai/agent": "workspace:*",
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel": "workspace:*",
    "@velaros-ai/model": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
