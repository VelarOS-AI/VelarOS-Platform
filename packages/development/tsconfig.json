{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "../..",
    "types": ["node", "bun"],
    "paths": {}
  },
  "include": ["src/**/*.ts", "spec/**/*.ts", "test/**/*.ts"]
}
