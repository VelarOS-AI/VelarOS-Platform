{
  "name": "@velaros-ai/development",
  "version": "1.0.5",
  "velaros": {
    "platform": "0.6"
  },
  "description": "Reusable language-service runtime for the Project code-understanding tool.",
  "license": "Apache-2.0",
  "author": "VelarOS",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --quiet",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "test": "bun run build && bun test test/development.test.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/development"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/project": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@velaros-ai/agent": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/development"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/development#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  }
}
