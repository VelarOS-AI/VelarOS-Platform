{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@velaros-ai/core": ["./src/index.ts"],
      "@velaros-ai/core/platform": ["./platform/index.ts"],
      "@velaros-ai/core/platform/contracts": ["./platform/contracts.ts"],
      "@velaros-ai/core/platform/shared-resources": ["./platform/shared-resources.ts"],
      "@velaros-ai/core/text-files": ["./text-files/index.ts"],
      "@velaros-ai/core/text-files/contracts": ["./text-files/contracts.ts"],
      "@velaros-ai/core/path-rules": ["./path-rules/index.ts"],
      "@velaros-ai/core/path-rules/contracts": ["./path-rules/contracts.ts"],
      "@velaros-ai/core/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "platform/**/*.ts",
    "text-files/**/*.ts",
    "path-rules/**/*.ts"
  ],
  "exclude": ["*/spec/**", "*/test/**"]
}
