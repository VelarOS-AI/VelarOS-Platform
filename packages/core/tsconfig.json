{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@velaros-ai/core": ["./src/index.ts"],
      "@velaros-ai/core/platform": ["./src/platform/index.ts"],
      "@velaros-ai/core/platform/contracts": ["./src/platform/contracts.ts"],
      "@velaros-ai/core/platform/shared-resources": ["./src/platform/shared-resources.ts"],
      "@velaros-ai/core/text-files": ["./src/text-files/index.ts"],
      "@velaros-ai/core/text-files/contracts": ["./src/text-files/contracts.ts"],
      "@velaros-ai/core/path-rules": ["./src/path-rules/index.ts"],
      "@velaros-ai/core/path-rules/contracts": ["./src/path-rules/contracts.ts"],
      "@velaros-ai/core/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts"],
  "exclude": ["src/*/spec/**", "src/*/test/**"]
}
