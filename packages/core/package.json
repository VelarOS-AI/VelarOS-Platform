{
  "name": "@velaros-ai/core",
  "version": "0.4.4",
  "velaros": {
    "platform": "0.6"
  },
  "description": "VelarOS 跨领域共享的底层：断言、错误、结果、类型守卫与无领域语义的通用原语，外加三个底层单元——platform（跨平台约定：路径文本、shell 命令规格、进程与系统信息命令、应用与数据目录、VelarOS 共享资源目录）、text-files（磁盘文本的无损读写：认编码、严格解码、按原编码写回、原子替换、有界读）与 path-rules（glob 匹配、.gitignore 的解析与判定、遍历时的忽略策略）。",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assert": {
      "types": "./dist/assert.d.ts",
      "import": "./dist/assert.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/error.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js"
    },
    "./logger/node": {
      "types": "./dist/logger/node.d.ts",
      "import": "./dist/logger/node.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./dist/result.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./platform/contracts": {
      "types": "./dist/platform/contracts.d.ts",
      "import": "./dist/platform/contracts.js"
    },
    "./platform/shared-resources": {
      "types": "./dist/platform/shared-resources.d.ts",
      "import": "./dist/platform/shared-resources.js"
    },
    "./text-files": {
      "types": "./dist/text-files/index.d.ts",
      "import": "./dist/text-files/index.js"
    },
    "./text-files/contracts": {
      "types": "./dist/text-files/contracts.d.ts",
      "import": "./dist/text-files/contracts.js"
    },
    "./path-rules": {
      "types": "./dist/path-rules/index.d.ts",
      "import": "./dist/path-rules/index.js"
    },
    "./path-rules/contracts": {
      "types": "./dist/path-rules/contracts.d.ts",
      "import": "./dist/path-rules/contracts.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/core/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test src/platform/spec/acceptance.test.ts src/platform/test src/text-files/spec/acceptance.test.ts src/text-files/test/text-file-io.test.ts src/text-files/test src/path-rules/spec/acceptance.test.ts src/path-rules/test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/core"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "iconv-lite": "^0.7.2",
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  }
}
