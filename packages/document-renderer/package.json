{
  "name": "@velaros-ai/document-renderer",
  "version": "0.1.6",
  "private": true,
  "velaros": {
    "platform": "0.6",
    "capabilityPack": true
  },
  "description": "Independent command capability pack for rendering Office documents and PDF pages.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "velar-document-renderer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/document-renderer"
  },
  "dependencies": {
    "@velaros-ai/office": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/document-renderer"
  }
}
