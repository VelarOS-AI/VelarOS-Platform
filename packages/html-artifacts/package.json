{
  "name": "@velaros-ai/html-artifacts",
  "version": "0.2.0",
  "velaros": {
    "platform": "0.6"
  },
  "description": "A framework-neutral streaming HTML artifact protocol and sandboxed iframe runtime.",
  "keywords": [
    "ai",
    "artifact",
    "html",
    "iframe",
    "streaming"
  ],
  "license": "Apache-2.0",
  "author": "Error-Zhang",
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/html-artifacts#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/html-artifacts"
  },
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node ../../scripts/build/normalize-package-declarations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run build && bun test spec/acceptance.test.ts test/protocol.test.ts test/documents.test.ts test/runtime.test.ts",
    "demo": "npm run build && vite demo",
    "demo:build": "npm run build && vite build demo --outDir ../demo-dist --emptyOutDir",
    "check:package-contract": "npm run build && node scripts/check-package-contract.mjs",
    "check": "npm run typecheck && npm test && npm run demo:build && npm run check:package-contract",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
