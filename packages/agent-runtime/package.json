{
  "name": "@velaros-ai/agent-runtime",
  "version": "0.5.0",
  "description": "Host-agnostic agent loop, prompt, orchestration, team, execution, and tool runtime for VelarOS-compatible hosts.",
  "license": "UNLICENSED",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/build/fix-esm-extensions.mjs dist && node ../../scripts/build/copy-velaros-globals-to-dist.mjs",
    "test": "bun run build && bun test test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/agent-runtime"
  },
  "dependencies": {
    "ai": "^6.0.168",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@velaros-ai/agent-protocol": "workspace:*",
    "@velaros-ai/core": "^0.3.2",
    "@velaros-ai/kernel-sdk": "^0.2.2",
    "execa": "^9.6.1",
    "typescript": "^5.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@types/node": "^22.19.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Agent.git",
    "directory": "packages/agent-runtime"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
