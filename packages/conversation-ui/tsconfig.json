{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "#contracts": ["./packages/conversation-ui/src/contracts/index.ts"],
      "#internal/*": ["./packages/conversation-ui/src/internal/*"],
      "@velaros-ai/ui": ["./packages/ui/src/index.ts"],
      "@velaros-ai/ui/*": ["./packages/ui/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
