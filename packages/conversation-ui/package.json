{
  "name": "@velaros-ai/conversation-ui",
  "version": "0.2.2",
  "description": "A host-agnostic React conversation UI with message blocks, tool renderers, stream pacing, and injected application ports.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "#internal/*": {
      "types": "./dist/internal/*.d.ts",
      "default": "./dist/internal/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composer": {
      "types": "./dist/composer/index.d.ts",
      "import": "./dist/composer/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./html-preview": {
      "types": "./dist/html-preview/index.d.ts",
      "import": "./dist/html-preview/index.js"
    },
    "./html-preview/htmlPreviewConstants": {
      "types": "./dist/html-preview/htmlPreviewConstants.d.ts",
      "import": "./dist/html-preview/htmlPreviewConstants.js"
    },
    "./html-preview/htmlPreviewDocument": {
      "types": "./dist/html-preview/htmlPreviewDocument.d.ts",
      "import": "./dist/html-preview/htmlPreviewDocument.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./markdown/streamdownMarkdown.config": {
      "types": "./dist/markdown/streamdownMarkdown.config.d.ts",
      "import": "./dist/markdown/streamdownMarkdown.config.js"
    },
    "./markdown/streamingMarkdownFlush.utils": {
      "types": "./dist/markdown/streamingMarkdownFlush.utils.d.ts",
      "import": "./dist/markdown/streamingMarkdownFlush.utils.js"
    },
    "./render-slots": {
      "types": "./dist/render-slots/index.d.ts",
      "import": "./dist/render-slots/index.js"
    },
    "./status": {
      "types": "./dist/status/index.d.ts",
      "import": "./dist/status/index.js"
    },
    "./stream": {
      "types": "./dist/stream/index.d.ts",
      "import": "./dist/stream/index.js"
    },
    "./tool-render": {
      "types": "./dist/tool-render/index.d.ts",
      "import": "./dist/tool-render/index.js"
    },
    "./tool-render/ToolCallBlock": {
      "types": "./dist/tool-render/ToolCallBlock.d.ts",
      "import": "./dist/tool-render/ToolCallBlock.js"
    },
    "./tool-render/command/CommandToolRenderDetails": {
      "types": "./dist/tool-render/command/CommandToolRenderDetails.d.ts",
      "import": "./dist/tool-render/command/CommandToolRenderDetails.js"
    },
    "./tool-render/command/commandToolRender.shared": {
      "types": "./dist/tool-render/command/commandToolRender.shared.d.ts",
      "import": "./dist/tool-render/command/commandToolRender.shared.js"
    },
    "./blocks/MessageBubble.module.css": "./dist/blocks/MessageBubble.module.css"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/build/generate-html-preview-css-module.mjs && bun run clean && tsc -p tsconfig.build.json && node ../../scripts/build/fix-esm-extensions.mjs dist && node ../../scripts/build/copy-css-assets-to-dist.mjs && node ../../scripts/build/compile-tailwind-css-assets.mjs dist && node ../../scripts/build/copy-velaros-globals-to-dist.mjs",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/conversation-ui"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@velaros-ai/html-artifacts": "^0.1.2",
    "@velaros-ai/ui": "workspace:*",
    "ahooks": "^3.9.7",
    "streamdown": "^2.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-UI.git",
    "directory": "packages/conversation-ui"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
