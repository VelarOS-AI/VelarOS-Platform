{
  "name": "@velaros-ai/agent",
  "version": "0.6.34",
  "velaros": {
    "platform": "0.6"
  },
  "description": "Host-agnostic agent loop, prompt, orchestration, team, execution, and tool runtime for VelarOS-compatible hosts, plus the versioned Agent wire contracts under ./protocol.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "import": "./dist/exports/index.js"
    },
    "./runtime": {
      "types": "./dist/exports/runtime.d.ts",
      "import": "./dist/exports/runtime.js"
    },
    "./host": {
      "types": "./dist/exports/host.d.ts",
      "import": "./dist/exports/host.js"
    },
    "./node": {
      "types": "./dist/exports/node.d.ts",
      "import": "./dist/exports/node.js"
    },
    "./chat-stream": {
      "types": "./dist/exports/chat-stream.d.ts",
      "import": "./dist/exports/chat-stream.js"
    },
    "./chat": {
      "types": "./dist/exports/chat.d.ts",
      "import": "./dist/exports/chat.js"
    },
    "./run-context": {
      "types": "./dist/exports/run-context.d.ts",
      "import": "./dist/exports/run-context.js"
    },
    "./protocol": {
      "types": "./dist/exports/protocol.d.ts",
      "import": "./dist/exports/protocol.js"
    },
    "./protocol/agent-capability": {
      "types": "./dist/exports/protocol/agent-capability.d.ts",
      "import": "./dist/exports/protocol/agent-capability.js"
    },
    "./protocol/execution": {
      "types": "./dist/exports/protocol/execution.d.ts",
      "import": "./dist/exports/protocol/execution.js"
    },
    "./protocol/external-agent-bridge": {
      "types": "./dist/exports/protocol/external-agent-bridge.d.ts",
      "import": "./dist/exports/protocol/external-agent-bridge.js"
    },
    "./protocol/lease": {
      "types": "./dist/exports/protocol/lease.d.ts",
      "import": "./dist/exports/protocol/lease.js"
    },
    "./protocol/message": {
      "types": "./dist/exports/protocol/message.d.ts",
      "import": "./dist/exports/protocol/message.js"
    },
    "./protocol/mods": {
      "types": "./dist/exports/protocol/mods.d.ts",
      "import": "./dist/exports/protocol/mods.js"
    },
    "./protocol/observability": {
      "types": "./dist/exports/protocol/observability.d.ts",
      "import": "./dist/exports/protocol/observability.js"
    },
    "./protocol/session": {
      "types": "./dist/exports/protocol/session.d.ts",
      "import": "./dist/exports/protocol/session.js"
    },
    "./tool-contract": {
      "types": "./dist/exports/tool-contract.d.ts",
      "import": "./dist/exports/tool-contract.js"
    },
    "./mcp": {
      "types": "./dist/exports/mcp.d.ts",
      "import": "./dist/exports/mcp.js"
    },
    "./mods": {
      "types": "./dist/exports/mods.d.ts",
      "import": "./dist/exports/mods.js"
    },
    "./bridge": {
      "types": "./dist/exports/bridge.d.ts",
      "import": "./dist/exports/bridge.js"
    },
    "./session": {
      "types": "./dist/exports/session.d.ts",
      "import": "./dist/exports/session.js"
    },
    "./remote": {
      "types": "./dist/exports/remote.d.ts",
      "import": "./dist/exports/remote.js"
    },
    "./remote/mcp": {
      "types": "./dist/exports/remote/mcp.d.ts",
      "import": "./dist/exports/remote/mcp.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/agent/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "check:browser": "node ../../scripts/agent/check-browser-surface.mjs",
    "check:public-api": "node ../../scripts/agent/check-public-api.mjs",
    "test": "bun run build && bun run check:browser && bun test test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/agent"
  },
  "dependencies": {
    "@types/json-schema": "7.0.15",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel": "workspace:*",
    "gpt-tokenizer": "3.4.0",
    "jszip": "^3.10.1",
    "ai": "^6.0.168",
    "execa": "^9.6.1",
    "typescript": "^5.7.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@types/node": "^22.19.17",
    "@types/ws": "^8.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/agent"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  }
}
