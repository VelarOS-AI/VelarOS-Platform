{
  "name": "@velaros-ai/agent",
  "version": "0.6.23",
  "velaros": {
    "platform": "0.6"
  },
  "description": "Host-agnostic agent loop, prompt, orchestration, team, execution, and tool runtime for VelarOS-compatible hosts, plus the versioned Agent wire contracts under ./protocol.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./chat-stream": {
      "types": "./dist/chat/stream/index.d.ts",
      "import": "./dist/chat/stream/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "import": "./dist/chat/index.js"
    },
    "./run-context": {
      "types": "./dist/agent/run-context/index.d.ts",
      "import": "./dist/agent/run-context/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./protocol/agent-capability": {
      "types": "./dist/protocol/agent-capability.d.ts",
      "import": "./dist/protocol/agent-capability.js"
    },
    "./protocol/execution": {
      "types": "./dist/protocol/execution.d.ts",
      "import": "./dist/protocol/execution.js"
    },
    "./protocol/external-agent-bridge": {
      "types": "./dist/protocol/external-agent-bridge.d.ts",
      "import": "./dist/protocol/external-agent-bridge.js"
    },
    "./protocol/lease": {
      "types": "./dist/protocol/lease.d.ts",
      "import": "./dist/protocol/lease.js"
    },
    "./protocol/message": {
      "types": "./dist/protocol/message.d.ts",
      "import": "./dist/protocol/message.js"
    },
    "./protocol/mods": {
      "types": "./dist/protocol/mods.d.ts",
      "import": "./dist/protocol/mods.js"
    },
    "./protocol/observability": {
      "types": "./dist/protocol/observability.d.ts",
      "import": "./dist/protocol/observability.js"
    },
    "./protocol/session": {
      "types": "./dist/protocol/session.d.ts",
      "import": "./dist/protocol/session.js"
    },
    "./tool-contract": {
      "types": "./dist/tool-contract/index.d.ts",
      "import": "./dist/tool-contract/index.js"
    },
    "./mcp": {
      "types": "./dist/tool-library/mcp/index.d.ts",
      "import": "./dist/tool-library/mcp/index.js"
    },
    "./mods": {
      "types": "./dist/mods/index.d.ts",
      "import": "./dist/mods/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote/index.js"
    },
    "./remote/mcp": {
      "types": "./dist/remote/mcp/index.d.ts",
      "import": "./dist/remote/mcp/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/agent/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "check:browser": "node ../../scripts/agent/check-browser-surface.mjs",
    "check:public-api": "node ../../scripts/agent/check-public-api.mjs",
    "test": "bun run build && bun run check:browser && bun test test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/agent"
  },
  "dependencies": {
    "@types/json-schema": "7.0.15",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel": "workspace:*",
    "gpt-tokenizer": "3.4.0",
    "jszip": "^3.10.1",
    "ai": "^6.0.168",
    "execa": "^9.6.1",
    "typescript": "^5.7.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@types/node": "^22.19.17",
    "@types/ws": "^8.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/agent"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  }
}
