{
  "name": "@velaros-ai/agent",
  "version": "1.5.0",
  "velaros": {
    "platform": "0.6"
  },
  "description": "Host-agnostic agent loop, prompt, orchestration, team, execution, and tool runtime for VelarOS-compatible hosts, plus the tool contract: define a tool once, police its model-facing description, mount a tool set onto the kernel, and bundle its schemas for the model.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js"
    },
    "./tool-contract": {
      "types": "./dist/tool-contract.d.ts",
      "import": "./dist/tool-contract.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/agent/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "check:browser": "node ../../scripts/agent/check-browser-surface.mjs",
    "check:public-api": "node ../../scripts/agent/check-public-api.mjs",
    "test": "bun run build && bun run check:browser && bun test spec/acceptance.test.ts test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/agent"
  },
  "dependencies": {
    "@types/json-schema": "7.0.15",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel": "workspace:*",
    "gpt-tokenizer": "3.4.0",
    "jszip": "^3.10.1",
    "ai": "^6.0.168",
    "execa": "^9.6.1",
    "typescript": "^5.7.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6",
    "@velaros-ai/context": "workspace:*"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@types/node": "^22.19.17",
    "@types/ws": "^8.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/agent"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  }
}
