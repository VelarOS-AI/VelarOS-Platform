{
  "name": "@velaros-ai/system",
  "version": "1.1.17",
  "velaros": {
    "platform": "0.6"
  },
  "description": "System-space files, execution, processes, desktop integration, contracts, and composition.",
  "license": "Apache-2.0",
  "author": "VelarOS",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "import": "./dist/exports/index.js"
    },
    "./contracts": {
      "types": "./dist/exports/contracts.d.ts",
      "import": "./dist/exports/contracts.js"
    },
    "./platform-compatibility": {
      "types": "./dist/exports/platform-compatibility.d.ts",
      "import": "./dist/exports/platform-compatibility.js"
    },
    "./shared-resources": {
      "types": "./dist/exports/shared-resources.d.ts",
      "import": "./dist/exports/shared-resources.js"
    }
  },
  "files": [
    "dist",
    "native/**/*.cpp",
    "native/build.mjs",
    "native/**/*.exe",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "test": "bun run build && bun test spec/acceptance.test.ts test/system.test.ts test/kernel-module.test.ts test/platform-compatibility.test.ts test/shell-readiness.test.ts test/git-bash-windows.test.ts test/process-host.test.ts test/process-lifecycle.test.ts test/system-search-visibility.test.ts test/shared-resources.test.ts",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/system"
  },
  "dependencies": {
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@velaros-ai/agent": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/system"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/system#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  }
}
