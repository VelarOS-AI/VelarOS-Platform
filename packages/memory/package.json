{
  "name": "@velaros-ai/memory",
  "version": "0.3.11",
  "velaros": {
    "platform": "0.6"
  },
  "description": "Evidence-grounded long-term memory tree, recall, and governance for VelarOS-compatible runtimes, with the workspace knowledge/vector product under ./knowledge and the kernel three-port glue under ./adapter-kernel.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "agent-memory",
    "long-term-memory",
    "retrieval",
    "sqlite",
    "velaros"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    },
    "./files": {
      "types": "./dist/files/index.d.ts",
      "import": "./dist/files/index.js"
    },
    "./vector": {
      "types": "./dist/vector/index.d.ts",
      "import": "./dist/vector/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "import": "./dist/knowledge/index.js"
    },
    "./knowledge/contracts": {
      "types": "./dist/knowledge/contracts.d.ts",
      "import": "./dist/knowledge/contracts.js"
    },
    "./adapter-kernel": {
      "types": "./dist/adapter-kernel/index.d.ts",
      "import": "./dist/adapter-kernel/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/memory/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "test": "bun run build && node --test ../../tests/memory/maintained/packages/memory/*.mjs && bun test test",
    "probe:authority-v2": "node ../../scripts/memory/checks/memoryAuthorityV2Probe.mjs",
    "probe:ingest-dream-v2": "node ../../scripts/memory/checks/memoryIngestDreamV2Probe.mjs",
    "probe:meaning-curation-v2": "node ../../scripts/memory/checks/memoryMeaningCurationV2Probe.mjs",
    "probe:erasure-saga-v2": "node ../../scripts/memory/checks/memoryErasureSagaV2Probe.mjs",
    "probe:evidence-replay-v2": "node ../../scripts/memory/checks/memoryEvidenceReplayV2Probe.mjs",
    "probe:query-runtime-v2": "node ../../scripts/memory/checks/memoryQueryRuntimeV2Probe.mjs",
    "probe:storage-v2": "bun --conditions=source src/memory-tree/v2/storage/storage-v2-probe.ts",
    "probe:files": "bun --conditions=source src/files/memory-files-probe.ts",
    "probe:vector": "bun --conditions=source src/vector/memory-vector-probe.ts",
    "probe:store-capability": "bun --conditions=source src/adapter-kernel/memory-store-capability-probe.ts",
    "probe:tree-store-v2": "node ../../scripts/memory/checks/memoryTreeStoreV2Probe.mjs",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/memory"
  },
  "dependencies": {
    "@velaros-ai/agent": "workspace:*",
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.17",
    "apache-arrow": "^18.1.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@lancedb/lancedb": "^0.27.2"
  },
  "peerDependenciesMeta": {
    "@lancedb/lancedb": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/memory"
  },
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/memory#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
