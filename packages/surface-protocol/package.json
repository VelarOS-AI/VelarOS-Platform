{
  "name": "@velaros-ai/surface-protocol",
  "version": "0.2.0",
  "velaros": {
    "platform": "0.6"
  },
  "description": "provider 自持代理面（Agent Surface）的线格式合同：带版本、不认宿主。",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "import": "./dist/exports/index.js"
    },
    "./contracts": {
      "types": "./dist/exports/contracts.d.ts",
      "import": "./dist/exports/contracts.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run build && bun test spec/acceptance.test.ts",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/surface-protocol"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/surface-protocol"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/surface-protocol#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  }
}
