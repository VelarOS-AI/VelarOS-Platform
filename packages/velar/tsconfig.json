{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@velaros-ai/velar/files": [
        "packages/velar/files/index.ts"
      ],
      "@velaros-ai/velar/files/contracts": [
        "packages/velar/files/contracts.ts"
      ],
      "@velaros-ai/velar/files/local": [
        "packages/velar/files/local.ts"
      ],
      "@velaros-ai/velar/images": [
        "packages/velar/images/index.ts"
      ],
      "@velaros-ai/velar/images/contracts": [
        "packages/velar/images/contracts.ts"
      ],
      "@velaros-ai/velar/images/local": [
        "packages/velar/images/local.ts"
      ],
      "@velaros-ai/velar/sandbox": [
        "packages/velar/sandbox/index.ts"
      ],
      "@velaros-ai/velar/sandbox/contracts": [
        "packages/velar/sandbox/contracts.ts"
      ],
      "@velaros-ai/velar/sandbox/local": [
        "packages/velar/sandbox/local.ts"
      ],
      "@velaros-ai/velar/shell": [
        "packages/velar/shell/index.ts"
      ],
      "@velaros-ai/velar/shell/contracts": [
        "packages/velar/shell/contracts.ts"
      ],
      "@velaros-ai/velar/shell/local": [
        "packages/velar/shell/local.ts"
      ],
      "@velaros-ai/velar/project": [
        "packages/velar/project/index.ts"
      ],
      "@velaros-ai/velar/project/contracts": [
        "packages/velar/project/contracts.ts"
      ],
      "@velaros-ai/velar/computer": [
        "packages/velar/computer/index.ts"
      ],
      "@velaros-ai/velar/computer/contracts": [
        "packages/velar/computer/contracts.ts"
      ],
      "@velaros-ai/velar/memory": [
        "packages/velar/memory/index.ts"
      ],
      "@velaros-ai/velar/memory/contracts": [
        "packages/velar/memory/contracts.ts"
      ],
      "@velaros-ai/velar/office": [
        "packages/velar/office/index.ts"
      ],
      "@velaros-ai/velar/office/contracts": [
        "packages/velar/office/contracts.ts"
      ],
      "@velaros-ai/velar/office/renderer": [
        "packages/velar/office/renderer.ts"
      ],
      "@velaros-ai/velar/browser": [
        "packages/velar/browser/index.ts"
      ],
      "@velaros-ai/velar/browser/contracts": [
        "packages/velar/browser/contracts.ts"
      ],
      "@velaros-ai/velar/browser/renderer": [
        "packages/velar/browser/renderer.ts"
      ],
      "@velaros-ai/velar/browser/electron": [
        "packages/velar/browser/electron.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "velaros-globals.d.ts",
    "files/**/*.ts",
    "images/**/*.ts",
    "shell/**/*.ts",
    "sandbox/**/*.ts",
    "project/**/*.ts",
    "computer/**/*.ts",
    "memory/**/*.ts",
    "office/**/*.ts",
    "browser/**/*.ts"
  ],
  "exclude": [
    "*/spec/**",
    "*/test/**",
    "dist",
    "node_modules"
  ]
}
