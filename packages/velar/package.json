  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "test": "bun run build && bun test files/spec/acceptance.test.ts files/test images/spec/acceptance.test.ts images/test shell/spec/acceptance.test.ts shell/test sandbox/spec/acceptance.test.ts sandbox/test project/spec/acceptance.test.ts project/test computer/spec/acceptance.test.ts computer/test knowledge/spec/acceptance.test.ts knowledge/test memory/spec/acceptance.test.ts memory/test office/spec/acceptance.test.ts office/test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/velar"
  },
