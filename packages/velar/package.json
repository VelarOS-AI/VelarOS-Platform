    },
    "./knowledge/contracts": {
      "types": "./dist/knowledge/contracts.d.ts",
      "import": "./dist/knowledge/contracts.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
