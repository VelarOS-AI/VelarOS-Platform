{
  "name": "@velaros-ai/script",
  "version": "0.3.4",
  "velaros": {
    "platform": "0.6"
  },
  "description": "Native Node.js execution with Execa, ripgrep, globby, diff, YAML, on-demand capabilities and host-owned process permissions.",
  "license": "Apache-2.0",
  "author": "VelarOS",
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/script#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/script"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "node_modules"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "test": "bun run build && bun test spec/acceptance.test.ts test/script.test.ts test/output.test.ts test/subprocess.test.ts test/module-semantics.test.ts test/diagnostics.test.ts test/contract-compiler.test.ts",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/script"
  },
  "dependencies": {
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel": "workspace:*",
    "@vscode/ripgrep": "^1.18.0",
    "diff": "^8.0.4",
    "execa": "^9.6.1",
    "globby": "^16.2.4",
    "typescript": "^5.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "bundledDependencies": [
    "globby"
  ]
}
