{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "../..",
    "noEmit": true,
    "paths": {
      "@velaros-ai/ui": ["./packages/ui/src/index.ts"],
      "@velaros-ai/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
