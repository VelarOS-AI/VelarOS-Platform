{
  "name": "@velaros-ai/cli",
  "version": "0.3.0",
  "velaros": {
    "platform": "0.6"
  },
  "description": "VelarOS 官方命令行发行包：velaros 可执行文件与可嵌入的运维命名空间路由器。",
  "license": "Apache-2.0",
  "author": "VelarOS",
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  },
  "keywords": [
    "cli",
    "command-router",
    "agent",
    "automation",
    "velaros"
  ],
  "type": "module",
  "bin": {
    "velaros": "./bin/velaros.mjs"
  },
  "main": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "import": "./dist/exports/index.js"
    },
    "./contracts": {
      "types": "./dist/exports/contracts.d.ts",
      "import": "./dist/exports/contracts.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "test": "bun run build && bun test spec/acceptance.test.ts",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/cli"
  },
  "dependencies": {
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/platform": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
