{
  "name": "@velaros-ai/game",
  "version": "0.1.0",
  "velaros": {
    "platform": "0.6"
  },
  "description": "Renderer-neutral game domain contracts, Phaser runtime projection, agent tools, and host composition behind explicit subpaths.",
  "license": "UNLICENSED",
  "author": "VelarOS",
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Capabilities#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  },
  "keywords": [
    "game-engine",
    "phaser",
    "ai-agent",
    "web-game"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "import": "./dist/composition/index.js"
    },
    "./composition/mod": {
      "types": "./dist/composition/mod.d.ts",
      "import": "./dist/composition/mod.js"
    },
    "./composition/turn-context": {
      "types": "./dist/composition/turn-context.d.ts",
      "import": "./dist/composition/turn-context.js"
    },
    "./browser/page-source": {
      "types": "./dist/browser/page-source.d.ts",
      "import": "./dist/browser/page-source.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "velaros.mod.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && bun run build:browser-page",
    "build:browser-page": "bun build src/runtime/browser-entry.ts --target=browser --format=esm --minify --outfile=dist/browser/page.js && node scripts/emitBrowserPageSource.mjs",
    "test": "bun run build && bun test test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/game"
  },
  "dependencies": {
    "@velaros-ai/agent": "workspace:*",
    "@velaros-ai/core": "workspace:*",
    "phaser": "4.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/game"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
