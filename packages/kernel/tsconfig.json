{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@velaros-ai/core": ["../core/src/index.ts"],
      "@velaros-ai/core/*": ["../core/src/*"],
      "@velaros-ai/kernel": ["./src/index.ts"],
      "@velaros-ai/kernel/*": ["./src/*"]
    },
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts"]
}
