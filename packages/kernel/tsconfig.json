{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@velaros-ai/core": ["../core/src/index.ts"],
      "@velaros-ai/core/*": ["../core/src/*"],
      "@velaros-ai/kernel": ["./src/index.ts"],
      "@velaros-ai/kernel/contracts": ["./src/contracts.ts"],
      "@velaros-ai/kernel/contracts/abi": ["./src/contracts-abi.ts"],
      "@velaros-ai/kernel/contracts/protocol": ["./src/contracts-protocol.ts"],
      "@velaros-ai/kernel/runtime": ["./src/runtime.ts"],
      "@velaros-ai/kernel/client": ["./src/client.ts"],
      "@velaros-ai/kernel/client/contracts": ["./src/client-contracts.ts"],
      "@velaros-ai/kernel/serve": ["./src/serve.ts"],
      "@velaros-ai/kernel/serve/updater": ["./src/serve-updater.ts"],
      "@velaros-ai/kernel/remote": ["./src/remote.ts"],
      "@velaros-ai/kernel/remote/client": ["./src/remote-client.ts"],
      "@velaros-ai/kernel/remote/node": ["./src/remote-node.ts"]
    },
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts"]
}
