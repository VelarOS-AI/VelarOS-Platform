{
  "name": "@velaros-ai/office-tools",
  "version": "0.2.7",
  "description": "Host-injected office document, spreadsheet, presentation, LaTeX/PDF, and PDF editing tools.",
  "license": "UNLICENSED",
  "author": "VelarOS",
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Capabilities#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Capabilities/issues"
  },
  "keywords": [
    "office",
    "documents",
    "spreadsheets",
    "presentations",
    "agent-tools"
  ],
  "type": "module",
  "bin": {
    "velaros-office": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && chmod +x dist/cli.js && node ../../scripts/capabilities/build/copy-velaros-globals-to-dist.mjs",
    "test:kernel-module": "bun test test/kernel-module.test.ts",
    "test": "bun run build && bun test test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/office-tools"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.394",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.3.6",
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Capabilities.git",
    "directory": "packages/office-tools"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
