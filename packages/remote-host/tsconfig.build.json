{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@velaros-ai/core": ["./packages/core/dist/index.d.ts"],
      "@velaros-ai/core/*": ["./packages/core/dist/*"],
      "@velaros-ai/kernel": ["./packages/kernel/dist/index.d.ts"],
      "@velaros-ai/kernel/*": ["./packages/kernel/dist/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
