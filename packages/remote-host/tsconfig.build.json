{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": [
      "node"
    ],
    "paths": {
      "@velaros-ai/core": [
        "./packages/core/dist/index.d.ts"
      ],
      "@velaros-ai/core/*": [
        "./packages/core/dist/*"
      ],
      "@velaros-ai/kernel": [
        "./packages/kernel/dist/index.d.ts"
      ],
      "@velaros-ai/kernel/*": [
        "./packages/kernel/dist/*"
      ],
      "@velaros-ai/agent": [
        "./packages/agent/dist/index.d.ts"
      ],
      "@velaros-ai/agent/*": [
        "./packages/agent/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
