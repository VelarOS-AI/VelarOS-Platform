{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@velaros-ai/agent": ["./packages/agent/dist/index.d.ts"],
      "@velaros-ai/agent/*": ["./packages/agent/dist/*"],
      "@velaros-ai/computer/runtime": ["./packages/computer/dist/runtime/index.d.ts"],
      "@velaros-ai/computer/tools": ["./packages/computer/dist/tools/index.d.ts"],
      "@velaros-ai/core": ["./packages/core/dist/index.d.ts"],
      "@velaros-ai/core/*": ["./packages/core/dist/*"],
      "@velaros-ai/kernel-client": ["./packages/kernel-client/dist/index.d.ts"],
      "@velaros-ai/kernel-client/*": ["./packages/kernel-client/dist/*"],
      "@velaros-ai/kernel-serve/daemon": ["./packages/kernel-serve/dist/daemon/index.d.ts"],
      "@velaros-ai/office-tools": ["./packages/office-tools/dist/index.d.ts"],
      "@velaros-ai/surface-protocol": ["./packages/surface-protocol/dist/index.d.ts"],
      "@velaros-ai/system-tools": ["./packages/system-tools/dist/index.d.ts"],
      "@velaros-ai/workspace": ["./packages/workspace/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
