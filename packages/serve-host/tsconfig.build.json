{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@velaros-ai/agent": ["./packages/agent/dist/index.d.ts"],
      "@velaros-ai/agent/*": ["./packages/agent/dist/*"],
      "@velaros-ai/computer/runtime": ["./packages/computer/dist/runtime/index.d.ts"],
      "@velaros-ai/computer/tools": ["./packages/computer/dist/tools/index.d.ts"],
      "@velaros-ai/core": ["./packages/core/dist/index.d.ts"],
      "@velaros-ai/core/*": ["./packages/core/dist/*"],
      "@velaros-ai/kernel": ["./packages/kernel/dist/index.d.ts"],
      "@velaros-ai/kernel/*": ["./packages/kernel/dist/*"],
      "@velaros-ai/office": ["./packages/office/dist/index.d.ts"],
      "@velaros-ai/surface-protocol": ["./packages/surface-protocol/dist/index.d.ts"],
      "@velaros-ai/system": ["./packages/system/dist/index.d.ts"],
      "@velaros-ai/project": ["./packages/project/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
