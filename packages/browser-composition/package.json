{
  "name": "@velaros-ai/browser-composition",
  "version": "0.2.5",
  "description": "React composition boundary for host-rendered controlled browser surfaces.",
  "license": "UNLICENSED",
  "author": "VelarOS",
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Capabilities#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Capabilities/issues"
  },
  "keywords": [
    "browser",
    "composition",
    "react",
    "adapter",
    "ai-agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/capabilities/build/copy-velaros-globals-to-dist.mjs",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/browser-composition"
  },
  "dependencies": {
    "@velaros-ai/browser-core": "workspace:*",
    "@velaros-ai/core": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Capabilities.git",
    "directory": "packages/browser-composition"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
