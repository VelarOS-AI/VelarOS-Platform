{
  "name": "@velaros-ai/computer",
  "version": "0.2.8",
  "velaros": {
    "platform": "0.6"
  },
  "description": "Computer-control capability package: the injectable OS-level sidecar runtime and the host-injected agent tool collection, each behind its own subpath.",
  "license": "Apache-2.0",
  "author": "VelarOS",
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/computer#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  },
  "keywords": [
    "computer-use",
    "sidecar",
    "desktop-automation",
    "input-control",
    "ai-agent"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist",
    "runtime",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "test": "bun test test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/computer"
  },
  "dependencies": {
    "@velaros-ai/agent": "workspace:*",
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/computer"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
