{
  "name": "@velaros-ai/browser",
  "version": "0.3.0",
  "velaros": {
    "platform": "0.6"
  },
  "description": "Browser capability package: the agent tool collection, site-workspace artifacts and user scripts, recipe execution, address/preference/screenshot policies, and the Electron-backed session runtime, behind four entries.",
  "license": "Apache-2.0",
  "author": "VelarOS",
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/browser#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  },
  "keywords": [
    "browser",
    "cdp",
    "automation",
    "chromium",
    "ai-agent"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "import": "./dist/electron.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "docs",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "generate:schema-bundle": "bun scripts/generate-tools-schema-bundle.mjs",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs && bun run generate:schema-bundle",
    "test": "bun run build && bun test spec/acceptance.test.ts test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/browser"
  },
  "dependencies": {
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel": "workspace:*",
    "@velaros-ai/platform": "workspace:*",
    "@velaros-ai/tool-contract": "workspace:*",
    "gifenc": "^1.0.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@velaros-ai/agent": "workspace:^",
    "@types/react": "^19.0.0",
    "electron": ">=41.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.0",
    "electron": "^41.10.2",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/browser"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
