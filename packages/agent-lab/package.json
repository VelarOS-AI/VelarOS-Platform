{
  "name": "@velaros-ai/agent-lab",
  "version": "0.2.0",
  "velaros": {
    "platform": "0.6"
  },
  "description": "可复现的连续旅程评测：诊断、统计与认证，连同 velaros-agent-lab 命令行；不认宿主。",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts",
  "bin": {
    "velaros-agent-lab": "./bin/velaros-agent-lab.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "import": "./dist/exports/index.js"
    },
    "./contracts": {
      "types": "./dist/exports/contracts.d.ts",
      "import": "./dist/exports/contracts.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/capabilities/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test spec/acceptance.test.ts test",
    "check:arch": "node scripts/check-architecture.mjs",
    "check:legacy": "bun scripts/check-legacy-equivalence.mjs",
    "check": "bun run typecheck && bun run test && bun run check:arch",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/agent-lab"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/agent-lab"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/agent-lab#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  }
}
