{
  "name": "@velaros-ai/kernel-daemon",
  "version": "0.3.2",
  "description": "serve 部署模式的配件:把 @velaros-ai/core 的 Kernel 库装成本机进程(daemon 生命周期 / local RPC 前脸 / ModStore / 进程内传输)。",
  "license": "UNLICENSED",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "velaros-kernel-daemon": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "packs",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/kernel/build/fix-esm-extensions.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test",
    "prepack": "node ../../scripts/build/buildPackageTopology.mjs --for @velaros-ai/kernel-daemon"
  },
  "dependencies": {
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel-client": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/kernel-daemon"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
