{
  "name": "@velaros-ai/model",
  "version": "0.6.4",
  "velaros": {
    "platform": "0.6"
  },
  "description": "Model provider adapters, provider script integration, and runtime model resolution for VelarOS-compatible hosts.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "llm",
    "model-provider",
    "provider-adapter",
    "ai-sdk",
    "dependency-injection",
    "velaros"
  ],
  "type": "module",
  "main": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports/index.d.ts",
      "import": "./dist/exports/index.js"
    },
    "./catalog": {
      "types": "./dist/exports/catalog.d.ts",
      "import": "./dist/exports/catalog.js"
    },
    "./contracts": {
      "types": "./dist/exports/contracts.d.ts",
      "import": "./dist/exports/contracts.js"
    },
    "./profiles": {
      "types": "./dist/exports/profiles.d.ts",
      "import": "./dist/exports/profiles.js"
    },
    "./provider-retry": {
      "types": "./dist/exports/provider-retry.d.ts",
      "import": "./dist/exports/provider-retry.js"
    },
    "./usage": {
      "types": "./dist/exports/usage.d.ts",
      "import": "./dist/exports/usage.js"
    },
    "./node": {
      "types": "./dist/exports/node.d.ts",
      "import": "./dist/exports/node.js"
    },
    "./provider-scripts/node": {
      "types": "./dist/exports/provider-scripts-node.d.ts",
      "import": "./dist/exports/provider-scripts-node.js"
    },
    "./ProviderScriptContextWindow": {
      "types": "./dist/exports/ProviderScriptContextWindow.d.ts",
      "import": "./dist/exports/ProviderScriptContextWindow.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/model/build/fix-esm-extensions.mjs dist && node ../../scripts/build/normalize-package-declarations.mjs",
    "test:kernel-module": "bun test test/kernel-module.test.ts",
    "test": "bun run build && bun test test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@types/json-schema": "7.0.15",
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/provider": "3.0.8",
    "@velaros-ai/core": "workspace:*",
    "@velaros-ai/kernel": "workspace:*",
    "ai": "^6.0.168"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform.git",
    "directory": "packages/model"
  },
  "homepage": "https://github.com/VelarOS-AI/VelarOS-Platform/tree/main/packages/model#readme",
  "bugs": {
    "url": "https://github.com/VelarOS-AI/VelarOS-Platform/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
