{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Keep the Model package independent of Bun-specific ambient types from the workspace root.
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
