{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // 导入 Platform 后根 node_modules/@types 含 Bun 类型,显式收窄回源仓的 @types 视野。
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
