#!/bin/sh
set -eu

APPDIR="${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
HOST_BIN="$APPDIR/usr/bin/velar-host"
export VELAROS_HOST_RESOURCES_ROOT="$APPDIR/usr/share/velar-host"

if [ -t 0 ] || [ -t 1 ]; then
  exec "$HOST_BIN" "$@"
fi

if command -v x-terminal-emulator >/dev/null 2>&1; then
  exec x-terminal-emulator -e "$HOST_BIN" "$@"
fi
if command -v gnome-terminal >/dev/null 2>&1; then
  exec gnome-terminal -- "$HOST_BIN" "$@"
fi
if command -v konsole >/dev/null 2>&1; then
  exec konsole -e "$HOST_BIN" "$@"
fi
if command -v xfce4-terminal >/dev/null 2>&1; then
  exec xfce4-terminal --command "$HOST_BIN"
fi
if command -v xterm >/dev/null 2>&1; then
  exec xterm -e "$HOST_BIN" "$@"
fi

echo "Velar Host needs a terminal. Run $HOST_BIN from your terminal." >&2
exit 1
