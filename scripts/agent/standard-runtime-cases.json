          {
            "id": "b",
            "updatedAt": "2026-01-02T00:00:00Z",
            "source": "a",
            "value": 3
          }
        ]
      }
    },
    {
      "id": "holdout-package",
      "split": "holdout",
      "prompt": "工作区已有 @fixture/rolling 包。按其文档，用该包计算 numbers.json 的窗口为 3 的滚动均值，输出 result.json。必须实际调用已安装包，不重新实现算法。",
      "files": {
        "numbers.json": "[2,4,6,8,10,12]",
        "node_modules/@fixture/rolling/package.json": "{\"name\":\"@fixture/rolling\",\"type\":\"module\",\"exports\":\"./index.mjs\"}",
        "node_modules/@fixture/rolling/README.md": "rolling(values, width) returns complete trailing window averages. ESM named export.",
        "node_modules/@fixture/rolling/index.mjs": "import {writeFileSync} from 'node:fs'; export function rolling(values,width){writeFileSync('.package-used','yes'); return values.slice(width-1).map((_,i)=>values.slice(i,i+width).reduce((a,b)=>a+b,0)/width)}"
      },
      "expected": {
        "result.json": [4, 6, 8, 10]
      },
      "grade": "assert.equal(await readFile('.package-used','utf8'),'yes');"
    },
    {
      "id": "holdout-pool",
      "split": "holdout",
      "prompt": "修复 pool.mjs 的 mapLimit(items, limit, fn)，在不超过 limit 的前提下并发处理，返回与输入顺序一致的结果。limit 必须是正整数，否则拒绝。fn 失败时让调用拒绝，并停止启动新任务。保留导出签名并用实际运行验证。",
      "files": {
        "pool.mjs": "export async function mapLimit(items,limit,fn){const result=[]; for (const item of items) result.push(await fn(item)); return result}\n"
      },
      "grade": "const {mapLimit}=await import('./pool.mjs'); let active=0,max=0; assert.deepEqual(await mapLimit([3,1,2,4],2,async n=>{max=Math.max(max,++active);await new Promise(r=>setTimeout(r,n*12));active--;return n*10}),[30,10,20,40]);assert.equal(max,2);await assert.rejects(()=>mapLimit([1],0,async x=>x));let count=0;await assert.rejects(()=>mapLimit([1,2,3,4],1,async()=>{count++;throw Error('fail')}));assert.equal(count,1);assert.deepEqual(await mapLimit([],2,async x=>x),[]);"
    },
