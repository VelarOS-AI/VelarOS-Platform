{
  "name": "velaros-memory",
  "version": "0.3.5",
  "private": true,
  "description": "VelarOS independent memory and knowledge product repository.",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build": "node scripts/build/buildPackageTopology.mjs",
    "check:boundaries": "node scripts/checkProductBoundaries.mjs && node --test scripts/checkProductBoundaries.test.mjs",
    "check:lock": "node --test scripts/checks/lockfileConsistency.test.mjs && node scripts/checks/lockfileConsistency.mjs",
    "check:consumer": "node --test scripts/checks/packageConsumerRunner.test.mjs scripts/checks/packageConsumerIndependence.test.mjs && node scripts/checks/portableContractsGate.mjs",
    "typecheck": "bun run --cwd packages/memory typecheck && bun run --cwd packages/knowledge typecheck && bun run --cwd packages/memory-adapter-kernel typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "bun run build && bun test tests/maintained/packages/memory/EmbeddingProfileIsolation.test.ts && node scripts/checks/knowledgeProfileIntegrationTest.mjs && node --test tests/maintained/packages/memory/*.mjs tests/maintained/packages/knowledge/*.mjs",
    "probe:anchors": "bun --conditions=source packages/memory/src/memory-tree/v2/treediff-v2-probe.ts",
    "probe:storage": "bun run --cwd packages/memory probe:storage-v2",
    "probe:authority": "bun run --cwd packages/memory probe:authority-v2",
    "probe:tree": "bun run --cwd packages/memory probe:tree-store-v2",
    "probe:ingest": "bun run --cwd packages/memory probe:ingest-dream-v2",
    "probe:meaning": "bun run --cwd packages/memory probe:meaning-curation-v2",
    "probe:erasure": "bun run --cwd packages/memory probe:erasure-saga-v2",
    "probe:replay": "bun run --cwd packages/memory probe:evidence-replay-v2",
    "probe:query": "bun run --cwd packages/memory probe:query-runtime-v2",
    "probe": "bun run probe:anchors && bun run probe:storage && bun run probe:authority && bun run probe:tree && bun run probe:ingest && bun run probe:meaning && bun run probe:erasure && bun run probe:replay && bun run probe:query",
    "check": "bun run check:boundaries && bun run build && bun run typecheck && bun run check:lock && bun run check:consumer && bun run lint && bun run test && bun run probe",
    "link:local": "node scripts/dev/link-local-packages.mjs",
    "release:dry-run": "node scripts/release/publish-packages.mjs --dry-run",
    "release:packages": "node scripts/release/publish-packages.mjs"
  },
  "devDependencies": {
    "@velaros-ai/core": "^0.3.2",
    "@velaros-ai/kernel-sdk": "^0.2.2",
    "@eslint/js": "^9.39.4",
    "@electron/rebuild": "^4.0.3",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "electron": "^41.10.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@velaros-ai/knowledge": "workspace:*",
    "@velaros-ai/memory": "workspace:*",
    "better-sqlite3": "^12.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Memory.git"
  }
}
