{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@velaros-ai/memory": ["./packages/memory/src/index.ts"],
      "@velaros-ai/knowledge": ["./packages/knowledge/src/index.ts"],
      "@velaros-ai/memory-adapter-kernel": [
        "./packages/memory-adapter-kernel/src/index.ts"
      ]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts"]
}
