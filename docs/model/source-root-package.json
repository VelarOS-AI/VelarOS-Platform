{
  "name": "velaros-model",
  "version": "0.4.6",
  "private": true,
  "description": "Independent model provider runtime for the VelarOS ecosystem.",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "bun run --cwd packages/model-runtime build",
    "typecheck": "bun run --cwd packages/model-runtime typecheck",
    "check:lock": "node --test scripts/checks/lockfileConsistency.test.mjs && node scripts/checks/lockfileConsistency.mjs",
    "check:consumer": "node --test scripts/checks/packageConsumerRunner.test.mjs scripts/checks/packageConsumerIndependence.test.mjs && node scripts/check-package-consumer.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "bun run --cwd packages/model-runtime test",
    "check:arch": "bun scripts/check-arch-boundaries.mjs",
    "check": "bun run build && bun run typecheck && bun run check:lock && bun run check:consumer && bun run lint && bun run test && bun run check:arch",
    "release:dry-run": "node scripts/release/publish-packages.mjs --dry-run",
    "release:packages": "node scripts/release/publish-packages.mjs"
  },
  "devDependencies": {
    "@velaros-ai/core": "^0.3.2",
    "@velaros-ai/kernel-sdk": "^0.2.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Model.git"
  }
}
