{
  "version": 2,
  "newInternalOperations": [
    {
      "operation": "replace_content",
      "owner": "editing planner",
      "exposure": "internal",
      "purpose": "Apply compiled source changes with exact expected-content validation.",
      "example": { "type": "replace_content", "path": "src/service.ts", "expectedContent": "old", "content": "new", "mode": "edit" }
    }
  ],
  "rows": [
