{
  "name": "velaros-core",
  "version": "0.3.2",
  "private": true,
  "description": "VelarOS Core: shared contracts, errors, constants, and runtime helpers published as @velaros-ai/core.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "node scripts/build/buildPackageTopology.mjs",
    "typecheck": "node scripts/run-workspace-script.mjs typecheck",
    "test": "node scripts/run-workspace-script.mjs test",
    "lint": "eslint . --max-warnings=0",
    "check:consumer": "node scripts/check-package-consumers.mjs",
    "check": "bun run build && bun run typecheck && bun run test && bun run lint && bun run check:consumer",
    "link:local": "node scripts/dev/link-local-packages.mjs",
    "release:dry-run": "node scripts/release/publish-packages.mjs --dry-run",
    "release:packages": "node scripts/release/publish-packages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "typescript": "^5.7.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
