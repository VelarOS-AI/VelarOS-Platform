{
  "name": "velaros-ui",
  "version": "0.2.2",
  "private": true,
  "description": "VelarOS UI monorepo: unified component library (@velaros-ai/ui) + conversation rendering facade (@velaros-ai/conversation-ui). Split from VelarOS-Desktop (R-ui-K1).",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "node scripts/build/buildPackageTopology.mjs",
    "build:component-library": "vite build --config component-library/vite.config.ts",
    "dev": "vite --config component-library/vite.config.ts",
    "typecheck": "node scripts/run-workspace-script.mjs typecheck && tsc --noEmit -p component-library/tsconfig.json",
    "test": "bun test tests",
    "lint": "eslint . --max-warnings=0",
    "component-library:api": "node scripts/component-library/generateComponentApi.mjs",
    "component-library:docs": "node scripts/checks/componentLibraryDocsFreshness.mjs",
    "component-library:independence": "node scripts/checks/componentLibraryIndependence.mjs",
    "check:runtime-boundaries": "node scripts/checks/componentLibraryIndependence.mjs",
    "check:package-contracts": "node scripts/checks/packageContracts.mjs",
    "component-library:verify": "bun run component-library:api && bun run component-library:docs && bun run component-library:independence",
    "check:component-library": "bun run component-library:verify",
    "check:ui-form-closure": "node scripts/check/uiComponentFormClosure.mjs",
    "check:ui-color-literal": "node scripts/check/uiColorLiteralClosure.mjs",
    "check": "bun run check:component-library && bun run build && bun run check:package-contracts && bun run build:component-library && bun run typecheck && bun run lint && bun run check:ui-form-closure && bun run check:ui-color-literal",
    "link:local": "node scripts/dev/link-local-packages.mjs",
    "release:dry-run": "node scripts/release/publish-packages.mjs --dry-run",
    "release:packages": "node scripts/release/publish-packages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.1.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-UI.git"
  }
}
